# LLM Endpoint Utama (Antigravity Proxy)
# Jika menjalankan di host lokal: http://localhost:3000/v1
# Jika menjalankan via Docker Compose (luco-app): http://antigravity-proxy:3000/v1
LLM_API_BASE=http://localhost:3000/v1
LLM_API_KEY=none
LLM_MODEL=antigravity-gemini-3-flash
ANTIGRAVITY_CLIENT_ID=
ANTIGRAVITY_CLIENT_SECRET=

# LLM Fallback (Otomatis dipakai bila Antigravity Proxy kuota habis atau akun belum terhubung)
LLM_FALLBACK_API_BASE=https://bifrost.tenzly.pro/v1
LLM_FALLBACK_API_KEY=sk-bf-xxxx-xxxx
LLM_FALLBACK_MODEL=yogathedev/deepseek-v4.1-flash

# Backend retrieval: "viking" (OpenViking) atau "local" (pencarian kata kunci sederhana di vault/)
LUCO_BACKEND=viking

# OpenViking Endpoint
# Host lokal: http://127.0.0.1:1933
# Docker Compose: http://openviking:1933
OPENVIKING_URL=http://127.0.0.1:1933
OPENVIKING_API_KEY=isi-api-key-openviking
VIKING_ROOT=viking://resources/luco

# PostgreSQL Database
# Host lokal: postgresql://luco:lucopass123@localhost:5432/lucodb
# Docker Compose: postgresql://luco:lucopass123@postgres:5432/lucodb
DATABASE_URL=postgresql://luco:lucopass123@localhost:5432/lucodb
POSTGRES_USER=luco
POSTGRES_PASSWORD=lucopass123
POSTGRES_DB=lucodb

# Keamanan & JWT Auth
# Ganti dengan string acak rahasia minimal 32 karakter untuk produksi
JWT_SECRET=rahasia-jwt-luco-untan-ganti-ini-sebelum-deploy
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting & Token Budget (Per-User Identity, Anti Ban IP)
RATE_LIMIT_RPM=20
RATE_LIMIT_TPM=40000
RATE_LIMIT_DAILY_TOKENS=200000

# CORS Origins (pisahkan koma untuk multiple origin)
CORS_ORIGINS=*

# Lokasi vault & lookup
VAULT_DIR=vault
LOOKUP_JSON=vault/lookup.json

# Batas agent
MAX_AGENT_STEPS=8
TRAJECTORY_LOG=logs/trajectory.jsonl

# Google OAuth 2.0 Credentials (Login SSO Mahasiswa & Dosen)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/v1/auth/google/callback
FRONTEND_URL=http://localhost:5173

# Admin Emails (Dipisahkan koma untuk otorisasi dasbor monitoring & audit)
ADMIN_EMAILS=d1041241069@student.untan.ac.id,d1041241027@student.untan.ac.id,d1041241038@student.untan.ac.id
